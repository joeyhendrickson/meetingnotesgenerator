# Meeting Notes Generator - Environment Variables
# Copy this file to .env.local and fill in your actual values

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Pinecone Configuration
# Get your API key and environment from: https://app.pinecone.io/
PINECONE_API_KEY=pcsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PINECONE_ENVIRONMENT=us-east-1-aws
# Example: us-east-1-aws, us-west1-gcp, etc.

# Pinecone Index Name
# This should match the name of your Pinecone index
# Default: ultra-index
PINECONE_INDEX_NAME=ultra-index

# Optional: default namespace for the main knowledge base (Chat + Google Drive tab). Empty = default namespace.
# PINECONE_NAMESPACE=

# --- Isolated section workspace (separate RAG; not mixed with main KB) ---
# Drive folder used only for section-specific files (add new files here, then vectorize from the Section workspace tab).
# GOOGLE_DRIVE_SECTION_FOLDER_ID=

# Required for section RAG: a dedicated Pinecone namespace within the same index (e.g. mng-section). Must not match the main KB namespace you use for the advisor.
# PINECONE_SECTION_NAMESPACE=mng-section

# Optional: write meeting note summaries from the Meeting transcripts tab to a different folder than the section transcript folder.
# MEETING_NOTES_SECTION_OUTPUT_FOLDER_ID=

# Google OAuth 2.0 Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/
# See GOOGLE_OAUTH_SETUP.md for detailed setup instructions
GOOGLE_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GOOGLE_PROJECT_ID=your-project-id

# Google OAuth Redirect URI
# For local development, use: http://localhost:3003/api/auth/google/callback (this app uses port 3003)
# For production, use your Vercel URL: https://your-app.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3003/api/auth/google/callback

# Google OAuth Refresh Token
# Get this by visiting /api/auth/google and following the authorization flow
# See CONNECT_GOOGLE_DRIVE.md for detailed instructions
GOOGLE_REFRESH_TOKEN=1//XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: upload meeting note summaries to a different folder than transcripts
# MEETING_NOTES_OUTPUT_FOLDER_ID=

# Display name on generated summaries (default: Joseph Hendrickson)
# MEETING_NOTES_AUTHOR=Joseph Hendrickson

# Google Drive Folder ID
# The ID of the root folder in Google Drive containing your Blackboard Ultra documents
# To find the folder ID: Open the folder in Google Drive, the ID is in the URL
# Example: https://drive.google.com/drive/folders/1a2b3c4d5e6f7g8h9i0j -> ID is: 1a2b3c4d5e6f7g8h9i0j
GOOGLE_DRIVE_FOLDER_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Application URL
# For local development: http://localhost:3003
# For production: Your Vercel URL (e.g., https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3003
